{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "yarn": "1.22.22",
      "android": { "image": "latest" },
      "ios": { "image": "latest" },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.19.4",
      "yarn": "1.22.22",
      "android": { "image": "latest" },
      "ios": { "image": "latest" },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "production": {
      "node": "20.19.4",
      "yarn": "1.22.22",
      "android": { "image": "latest" },
      "ios": { "image": "latest" },
      "autoIncrement": true,
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
